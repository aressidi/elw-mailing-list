# Production Environment Template
# Copy these values to your deployment platforms

# Neon PostgreSQL (from Neon console)
DATABASE_URL=postgresql://[user]:[password]@[host].neon.tech/[dbname]?sslmode=require

# Render will set this automatically
PORT=10000

# Production settings
NODE_ENV=production

# Frontend URL (update after Vercel deploy)
CLIENT_URL=https://elw-mailing-list.vercel.app